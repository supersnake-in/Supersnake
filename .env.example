# ============================================================
# SUPERSNAKE.IN — ENVIRONMENT CONFIGURATION TEMPLATE
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT
# ============================================================

# 1. SUPABASE (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key # SERVER-SIDE ONLY

# 2. RAZORPAY (Payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id # Client-safe public key ID
RAZORPAY_KEY_SECRET=your_razorpay_secret_key     # SERVER-SIDE ONLY - NEVER EXPOSE
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret      # SERVER-SIDE ONLY - NEVER EXPOSE

# 3. RESEND (Transactional Emails)
RESEND_API_KEY=re_your_secret_api_key            # SERVER-SIDE ONLY - NEVER EXPOSE
RESEND_FROM_EMAIL=concierge@supersnake.in

# 4. ADMIN ACCESS PIN / PASSKEY (For Atelier security)
ADMIN_SECRET_PIN=2026 # Change in production
